{
  "name": "cedo-rehab-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Clínico y Administrativo Integral CEDO-REHAB EIRL",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
